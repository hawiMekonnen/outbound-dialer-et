# ==============================================================================
# Ethio Telecom Automatic Dialer - Environment Configuration
# ==============================================================================

# Web Application Port on Host Machine
PORT=8080

# Database Configuration (pgsql for PostgreSQL, sqlite for fallback)
DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ethio_dialer
DB_USER=postgres
DB_PASSWORD=ethiodialer123

# FreeSWITCH Event Socket (ESL) Configuration (Optional)
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon

# Outbound Telephony & Pacing
SIP_DEFAULT_CALLER_ID=+251911002233
DEFAULT_PACING_MODE=predictive
MAX_CONCURRENT_CALLS=1000
CALLS_PER_SECOND=17
